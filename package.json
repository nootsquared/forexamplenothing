{
  "name": "golazo-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node tools/texgen/index.mjs && node tools/audiogen/index.mjs",
    "dev": "vite",
    "prebuild": "node tools/texgen/index.mjs && node tools/audiogen/index.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "gen:assets": "node tools/texgen/index.mjs && node tools/audiogen/index.mjs",
    "gen:audio": "node tools/audiogen/index.mjs",
    "test": "vitest run",
    "cf:dev": "wrangler dev --port 8788",
    "cf:deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@napi-rs/canvas",
      "workerd",
      "sharp"
    ]
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5",
    "wrangler": "^4.118.0",
    "ws": "^8.21.1"
  }
}
